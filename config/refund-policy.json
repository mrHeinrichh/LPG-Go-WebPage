{
  "config_name": "lpggo_return_refund_policy",
  "version": "3.0.0",
  "effective_date": "2026-08-10",
  "currency": "PHP",
  "return_action_windows": {
    "delivered_full_refund_minutes": 30,
    "completed_replace_minutes": 60,
    "expired_action": "REPORT_OR_DISPUTE",
    "safety_reports_always_reviewable": true
  },
  "transaction_fee": {
    "source": "SUPERADMIN_SETTINGS",
    "adjustable": true,
    "displayed_before_customer_confirmation": true,
    "held_on_status": "MERCHANT_APPROVAL",
    "delivery_hold_backstop": true,
    "finalized_after_status": "COMPLETED_PLUS_REPLACEMENT_WINDOW",
    "replacement_window_minutes": 60,
    "reversed_on_eligible_full_return_refund": true
  },
  "complaint_reasons": [
    {
      "code": "WRONG_ITEM",
      "label_en": "Wrong brand, size, or order type delivered",
      "category": "PRODUCT",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 0.5,
      "evidence_required": true,
      "evidence_types": ["photo", "order_record"],
      "allowed_resolutions": ["REPLACEMENT", "FULL_REFUND"],
      "default_resolution": "REPLACEMENT",
      "tank_retrieval_required": true
    },
    {
      "code": "UNDERFILLED",
      "label_en": "Cylinder may be underfilled or short weight",
      "category": "PRODUCT",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 48,
      "evidence_required": true,
      "evidence_types": ["photo", "video", "weight_record"],
      "allowed_resolutions": ["PARTIAL_REFUND", "REPLACEMENT", "MANUAL_REVIEW"],
      "default_resolution": "MANUAL_REVIEW"
    },
    {
      "code": "LEAKING",
      "label_en": "Leaking valve or gas smell",
      "category": "PRODUCT",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": null,
      "evidence_required": true,
      "evidence_types": ["photo", "video", "text_description"],
      "allowed_resolutions": ["REPLACEMENT", "FULL_REFUND", "SAFETY_ESCALATION"],
      "default_resolution": "SAFETY_ESCALATION",
      "tank_retrieval_required": true,
      "safety_priority": true,
      "show_safety_advisory": true,
      "safety_advisory_en": "Do not ignite a flame or operate electrical switches. If safe, close the regulator, ventilate the area, move people away, and contact emergency responders for an uncontrolled leak or fire."
    },
    {
      "code": "DAMAGED_CYLINDER",
      "label_en": "Damaged, heavily rusted, or dented cylinder",
      "category": "PRODUCT",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 1,
      "evidence_required": true,
      "evidence_types": ["photo"],
      "allowed_resolutions": ["REPLACEMENT", "FULL_REFUND", "SAFETY_ESCALATION"],
      "default_resolution": "REPLACEMENT",
      "tank_retrieval_required": true,
      "safety_priority": true
    },
    {
      "code": "BROKEN_SEAL",
      "label_en": "Broken or missing safety seal",
      "category": "PRODUCT",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 1,
      "evidence_required": true,
      "evidence_types": ["photo"],
      "allowed_resolutions": ["REPLACEMENT", "FULL_REFUND"],
      "default_resolution": "REPLACEMENT",
      "tank_retrieval_required": true,
      "safety_priority": true
    },
    {
      "code": "INCOMPLETE_ORDER",
      "label_en": "Missing product or accessory",
      "category": "PRODUCT",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 1,
      "evidence_required": true,
      "evidence_types": ["photo", "order_record"],
      "allowed_resolutions": ["REDELIVER_MISSING", "PARTIAL_REFUND"],
      "default_resolution": "REDELIVER_MISSING"
    },
    {
      "code": "NOT_DELIVERED",
      "label_en": "Order did not arrive",
      "category": "DELIVERY",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": null,
      "evidence_required": true,
      "evidence_types": ["status_history", "gps", "timestamp", "communication_record"],
      "allowed_resolutions": ["REDELIVER", "FULL_REFUND", "MANUAL_REVIEW"],
      "default_resolution": "MANUAL_REVIEW"
    },
    {
      "code": "FAILED_DELIVERY_DISPUTE",
      "label_en": "Failed-delivery or reschedule record is disputed",
      "category": "DELIVERY",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 24,
      "evidence_required": true,
      "evidence_types": ["gps", "timestamp", "photo", "communication_record"],
      "allowed_resolutions": ["REDELIVER", "FULL_REFUND", "ESCALATE_REVIEW"],
      "default_resolution": "ESCALATE_REVIEW"
    },
    {
      "code": "RIDER_ISSUE",
      "label_en": "Rider behavior or handling concern",
      "category": "DELIVERY",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 24,
      "evidence_required": true,
      "evidence_types": ["photo", "video", "communication_record"],
      "allowed_resolutions": ["ACKNOWLEDGE", "ESCALATE_REVIEW"],
      "default_resolution": "ESCALATE_REVIEW"
    },
    {
      "code": "OVERCHARGED",
      "label_en": "Amount collected exceeds the in-app amount due",
      "category": "DELIVERY",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 24,
      "evidence_required": true,
      "evidence_types": ["receipt", "order_record", "payment_record"],
      "allowed_resolutions": ["PARTIAL_REFUND", "MANUAL_REVIEW"],
      "default_resolution": "MANUAL_REVIEW",
      "applies_to_payment": ["COD"]
    },
    {
      "code": "CUSTOMER_UNAVAILABLE",
      "label_en": "Customer or authorized recipient was unavailable",
      "category": "CUSTOMER",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 24,
      "evidence_required": true,
      "evidence_types": ["gps", "timestamp", "photo", "contact_attempts"],
      "allowed_resolutions": ["RESCHEDULE", "CANCEL_AFTER_REVIEW"],
      "default_resolution": "RESCHEDULE"
    },
    {
      "code": "CHANGED_MIND",
      "label_en": "Changed mind or ordered by mistake",
      "category": "CUSTOMER",
      "fault_party": "CUSTOMER",
      "claim_window_hours": 0,
      "evidence_required": false,
      "allowed_resolutions": ["DENIED_NOT_COVERED", "MERCHANT_GOODWILL_OPTIONAL"],
      "default_resolution": "DENIED_NOT_COVERED"
    },
    {
      "code": "OTHER",
      "label_en": "Other issue",
      "category": "OTHER",
      "fault_party": "PENDING_REVIEW",
      "claim_window_hours": 24,
      "evidence_required": true,
      "evidence_types": ["photo", "text_description"],
      "allowed_resolutions": ["MANUAL_REVIEW"],
      "default_resolution": "MANUAL_REVIEW"
    }
  ],
  "cancellation_rules": {
    "before_acceptance": {
      "allowed": true,
      "refund_type": "FULL",
      "customer_fee": 0
    },
    "after_acceptance_or_pickup": {
      "allowed": "REVIEW_REQUIRED",
      "reason_and_evidence_required": true,
      "possible_delivery_or_cancellation_charge": "AS_DISPLAYED_OR_APPROVED",
      "admin_outcomes": ["CANCEL", "RETURN_TO_WAITING_FOR_REDISPATCH"]
    },
    "after_completed_delivery": {
      "allowed": false,
      "exception": "ELIGIBLE_RETURN_REPLACEMENT_REFUND_OR_LEGAL_RIGHT"
    }
  },
  "resolution_ladder": [
    {
      "order": 1,
      "code": "REPLACEMENT",
      "money_movement": false,
      "tank_swap": true
    },
    {
      "order": 2,
      "code": "PARTIAL_REFUND",
      "money_movement": true
    },
    {
      "order": 3,
      "code": "FULL_REFUND",
      "money_movement": true,
      "tank_retrieval_required": true,
      "simultaneous_exchange_rule": true
    }
  ],
  "refund_funding_matrix": [
    {
      "payment_method": "ONLINE",
      "escrow_state": "PENDING",
      "funding_source": "UNRELEASED_PAYMENT_OR_PROCESSOR_REVERSAL"
    },
    {
      "payment_method": "ONLINE",
      "escrow_state": "RELEASED",
      "funding_source": "MERCHANT_SETTLEMENT_OR_SCC",
      "fallback": "FUTURE_PAYOUT_DEDUCTION"
    },
    {
      "payment_method": "COD",
      "funding_source": "MERCHANT_CASH_ON_RETRIEVAL",
      "fallback": "MERCHANT_SCC_DEDUCTION"
    },
    {
      "payment_method": "ANY",
      "escrow_state": "DEALER_FUNDS_EXHAUSTED",
      "funding_source": "MANUAL_ADMIN_REVIEW",
      "requires_approval": "AUTHORIZED_ADMIN"
    }
  ],
  "refund_destinations": [
    {
      "code": "ORIGINAL_METHOD",
      "label_en": "Original payment method, when supported",
      "processing_days_min": 0,
      "processing_days_max": 10,
      "is_default": true
    },
    {
      "code": "APPROVED_BANK_OR_EWALLET",
      "label_en": "Approved bank or e-wallet account",
      "processing_days_min": 1,
      "processing_days_max": 10
    }
  ],
  "cash_refund_dual_confirmation": {
    "enabled": true,
    "merchant_action": "MARK_REFUND_ISSUED",
    "customer_action": "CONFIRM_RECEIVED",
    "confirmation_methods": ["IN_APP_TAP", "QR_SCAN", "PHOTO_RECEIPT"],
    "customer_confirmation_timeout_hours": 24,
    "on_timeout_fallback": "ADMIN_REVIEW"
  },
  "store_service_credit": {
    "purpose": "STORE_SIDE_SERVICE_LEDGER",
    "display_unit": "SSC_WITHOUT_CURRENCY_SYMBOL",
    "not_customer_money": true,
    "not_bank_deposit": true,
    "not_electronic_money": true,
    "not_general_payment_account": true,
    "non_transferable_between_users": true,
    "server_controlled_mutations": true,
    "minimum_requirement_source": "SUPERADMIN_SETTINGS",
    "fees_adjustable": true,
    "insufficient_balance_action": "CLOSE_OR_RESTRICT_STORE_UNTIL_REQUIREMENT_IS_MET",
    "unused_credit_refund": {
      "request_required": true,
      "admin_review_required": true,
      "processing_fee_source": "SUPERADMIN_SETTINGS",
      "rejected_request_restores_reserved_credit": true,
      "not_user_cashout_or_transfer": true
    },
    "ledger_entry_types": [
      "PURCHASE",
      "FEE_HOLD",
      "FEE_FINALIZATION",
      "FEE_REVERSAL",
      "REFUND_DEDUCTION",
      "PAYOUT_DEDUCTION",
      "ADMIN_ADJUSTMENT"
    ]
  },
  "fee_lifecycle": {
    "hold_at_merchant_approval": true,
    "hold_at_delivery_only_as_backstop": true,
    "finalize_after_completed_replacement_window": true,
    "replacement_window_minutes": 60,
    "reverse_for_eligible_return_refund_before_finalization": true
  },
  "credit_orders": {
    "availability": "STORE_SPECIFIC_MERCHANT_APPROVAL",
    "customer_cash_due_at_delivery": false,
    "payment_status": "ON_CREDIT",
    "merchant_must_confirm_eligibility_before_approval": true,
    "lpg_go_is_not_lender": true,
    "repayment_terms_are_between_customer_and_merchant": true,
    "platform_record_is_not_a_government_credit_registry": true
  },
  "cylinder_credit_returns": {
    "purpose": "TRACK_CYLINDERS_LEFT_WITH_CUSTOMERS",
    "customer_return_without_new_order_supported": true,
    "original_order_address_locked": true,
    "customer_photo_required": true,
    "photo_max_size_mb": 5,
    "merchant_physical_receipt_confirmation_required": true,
    "pending_request_blocks_duplicate_return": true,
    "outside_app_records_are_merchant_entered": true,
    "outside_app_records_are_not_platform_verified_sales": true
  },
  "delivery_review": {
    "failed_delivery_after_pickup_requires_reason_and_evidence": true,
    "admin_may_cancel_or_redispatch": true,
    "customer_and_merchant_notifications": true,
    "final_courier_identity_frozen_at_delivery": true,
    "gps_is_supporting_not_conclusive_evidence": true
  },
  "merchant_plans": {
    "plans": ["BASIC", "BUSINESS", "PRO"],
    "basic_is_free": true,
    "paid_plans_are_monthly": true,
    "completed_order_milestones_may_unlock_features": true,
    "admin_overrides_and_custom_permissions_supported": true,
    "prices_and_features_may_change_with_notice": true
  },
  "service_targets_hours": {
    "general_first_response": 24,
    "safety_first_response": 1,
    "review_after_complete_evidence": 72,
    "targets_are_not_guarantees": true
  },
  "fraud_guards": {
    "neutral_evidence": ["status_history", "gps", "timestamp", "photo", "communication_record", "payment_record"],
    "customer": {
      "repeat_or_inconsistent_claims": "MANUAL_REVIEW_OR_RESTRICTION"
    },
    "merchant_and_rider": {
      "repeat_failed_delivery_or_fault_patterns": "MANUAL_REVIEW_OR_RESTRICTION",
      "safety_violation_immediate_review": true
    },
    "off_app_settlement_recognized": false
  },
  "retrieval_rules": {
    "simultaneous_exchange_rule": true,
    "refund_release_may_be_gated_on_retrieval": true,
    "condition_and_identity_must_be_documented": true,
    "retrieved_safety_tank_redeploy": false,
    "unreachable_party_action": "ADMIN_REVIEW"
  }
}
